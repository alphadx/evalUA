# ============================================
# EvalUA v3.0 — Variables de Entorno
# ============================================
# Copiar este archivo como .env y configurar los valores
# cp .env.example .env

# --- JWT ---
# Secreto simétrico HS256 (256 bits mínimo)
# Generar con: openssl rand -base64 32
KEY=

# --- MongoDB ---
MONGODB_URI=mongodb://evalua-mongodb:27017/evalua

# --- Redis ---
REDIS_URL=redis://evalua-redis:6379

# --- Seguridad ---
# Dominios permitidos para frame-ancestors CSP (separados por espacio)
ALLOWED_HOSTS=http://localhost:3000

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
